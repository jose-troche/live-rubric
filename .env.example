# ---------------------------------------------------------------------------
# Primary provider: TypeSafe Jev via Vercel AI Gateway.
# On Vercel this needs NO setup: the platform injects VERCEL_OIDC_TOKEN and the
# gateway authenticates with it. Set a key explicitly only for local `next dev`
# (run `vercel env pull` to get an OIDC token locally instead).
# ---------------------------------------------------------------------------
AI_GATEWAY_API_KEY=vck_...

# ---------------------------------------------------------------------------
# Fallback provider: OpenJev on Codiv. Same wire API, different model.
# Used automatically when the gateway errors, runs out of free credit, or stalls.
# Free tier: 100M input tokens, no card. https://codiv.ai/
# ---------------------------------------------------------------------------
CODIV_API_KEY=sk-codiv-...

# Optional overrides
# TYPESAFE_API_KEY=            # direct api.typesafe.ai key, used as primary if set
# LIVE_RUBRIC_PRIMARY=vercel   # vercel | typesafe | codiv
