# ---------------------------------------------------------------------------
# The only credential the app needs: OpenJev on Codiv.
# Free tier: 100M input tokens, no card. https://codiv.ai/
#
# Vercel AI Gateway was removed as the primary provider: it will not service an
# evaluation without a credit card on file (403 customer_verification_required),
# so its free credit cannot be reached without one.
# ---------------------------------------------------------------------------
CODIV_API_KEY=sk-codiv-...

# Optional overrides
# CODIV_BASE_URL=https://api.codiv.ai
# LIVE_RUBRIC_CODIV_MODEL=openjev-latest
